{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/rafjasn/documents/packages/shared/contracts/chat-request.schema.json",
    "title": "ChatRequest",
    "description": "Body of POST /v1/chat/stream, which the API sends to ai-service with the user's JWT. The user comes from the token only. Mirrors ChatRequest in packages/shared/src/index.ts.",
    "type": "object",
    "required": ["conversationId", "message", "history", "scope"],
    "additionalProperties": false,
    "properties": {
        "conversationId": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "history": {
            "description": "Earlier turns, oldest first; the API sends the most recent ones.",
            "type": "array",
            "maxItems": 20,
            "items": {
                "type": "object",
                "required": ["role", "content"],
                "additionalProperties": false,
                "properties": {
                    "role": { "enum": ["user", "assistant"] },
                    "content": { "type": "string" }
                }
            }
        },
        "scope": { "$ref": "#/$defs/scope" }
    },
    "$defs": {
        "scope": {
            "description": "What the conversation may search. Empty means the user's whole library.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "documentIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 100 },
                "categories": { "type": "array", "items": { "enum": ["INVOICE", "RECEIPT", "CONTRACT", "OTHER"] } },
                "languages": { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 2 } },
                "dateFrom": { "type": "string", "format": "date" },
                "dateTo": { "type": "string", "format": "date" }
            }
        }
    }
}
