{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/rafjasn/documents/packages/shared/contracts/ws-document-status-event.schema.json",
    "title": "WsDocumentStatusEvent",
    "description": "Document status change. Workers publish it to the notifications SNS topic with message attributes eventType=DOCUMENT_STATUS and userId; the API pushes it to the browser over Socket.IO. Mirrors WsDocumentStatusEvent in packages/shared/src/index.ts.",
    "type": "object",
    "required": ["documentId", "status", "timestamp"],
    "additionalProperties": false,
    "properties": {
        "documentId": {
            "type": "string",
            "minLength": 1
        },
        "status": {
            "enum": [
                "PENDING",
                "PROCESSING",
                "EXTRACTING",
                "CLASSIFYING",
                "SUMMARIZING",
                "INDEXING",
                "COMPLETED",
                "FAILED"
            ]
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "document": {
            "description": "Partial DocumentRecord with the fields that changed in this step.",
            "type": "object"
        }
    }
}
