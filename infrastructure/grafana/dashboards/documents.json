{
    "uid": "documents",
    "title": "Documents",
    "tags": ["documents"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "editable": false,
    "time": {
        "from": "now-3h",
        "to": "now"
    },
    "refresh": "30s",
    "panels": [
        {
            "type": "row",
            "title": "Chat",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "panels": [],
            "id": 1
        },
        {
            "type": "timeseries",
            "title": "Questions per minute, by outcome",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 1
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (outcome) (rate(docai_chat_requests_total[5m])) * 60",
                    "legendFormat": "{{outcome}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 1,
                        "fillOpacity": 10,
                        "showPoints": "auto",
                        "spanNulls": true,
                        "stacking": {
                            "mode": "normal",
                            "group": "A"
                        }
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "id": 2
        },
        {
            "type": "timeseries",
            "title": "Chat latency, question to last event",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 1
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "histogram_quantile(0.5, sum by (le) (rate(docai_chat_seconds_bucket[5m])))",
                    "legendFormat": "p50"
                },
                {
                    "refId": "B",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(docai_chat_seconds_bucket[5m])))",
                    "legendFormat": "p95"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 1,
                        "fillOpacity": 10,
                        "showPoints": "auto",
                        "spanNulls": true
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "description": "Alert above 15 s at p95 over 10 minutes",
            "id": 3
        },
        {
            "type": "timeseries",
            "title": "Error rate, chat and uploads",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 1
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "((sum(increase(docai_chat_requests_total{outcome=\"failed\"}[5m])) or vector(0)) + (sum(increase(docai_documents_total{status=\"failed\"}[5m])) or vector(0))) / ((sum(increase(docai_chat_requests_total[5m])) or vector(0)) + (sum(increase(docai_documents_total[5m])) or vector(0)))",
                    "legendFormat": "failed share"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 1,
                        "fillOpacity": 10,
                        "showPoints": "auto",
                        "spanNulls": true
                    },
                    "min": 0,
                    "max": 1
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "description": "Alert above 20% for a minute",
            "id": 4
        },
        {
