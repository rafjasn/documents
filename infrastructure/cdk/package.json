{
    "name": "@documents/cdk",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "tsc",
        "check": "tsc --noEmit",
        "test": "jest",
        "synth": "cdk synth",
        "cost": "ts-node scripts/cost-estimate.ts",
        "diff": "cdk diff",
        "deploy:infra": "cdk deploy DocumentsInfraStack",
        "deploy:services": "cdk deploy DocumentsServicesStack",
        "destroy": "cdk destroy --all"
    },
    "dependencies": {
        "aws-cdk-lib": "2.273.0",
        "cdk-nag": "3.0.2",
        "constructs": "10.8.1"
    },
    "devDependencies": {
        "@types/jest": "30.0.0",
        "@types/node": "^25.6.0",
        "@types/source-map-support": "^0.5.10",
        "aws-cdk": "2.1145.0",
        "jest": "30.5.2",
        "source-map-support": "^0.5.21",
        "ts-jest": "29.4.14",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    },
    "jest": {
        "testEnvironment": "node",
        "roots": [
            "<rootDir>/test"
        ],
        "transform": {
            "^.+\\.ts$": "ts-jest"
        },
        "testTimeout": 120000
    }
}
