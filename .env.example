# App 
NODE_ENV=development
JWT_SECRET=dev-secret-change-in-production

# AWS / LocalStack 
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=documents-uploads
DYNAMODB_TABLE=documents-documents
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:documents-notifications
ALLOWED_ORIGINS=https://app.example.com,https://documents-xxx.cloudfront.net

# SQS
SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/documents-processing
SQS_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/documents-dlq
SQS_POLLING_INTERVAL=5000
SQS_MAX_MESSAGES=5

# Ports
API_PORT=3001
WORKER_PORT=3002
FRONTEND_PORT=3000

# API / Worker 
CORS_ORIGIN=http://localhost

# LocalStack
LOCALSTACK_SERVICES=s3,sqs,dynamodb,sns,logs,cloudwatch
LOCALSTACK_DEBUG=0

# Ollama (optional profile, for the stretch work only)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Auth service
# Set to "cognito" to use AWS Cognito instead of Keycloak
AUTH_PROVIDER=keycloak

# Keycloak - used when AUTH_PROVIDER=keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=documents
KEYCLOAK_CLIENT_ID=documents-app
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=documents-api
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_IN_ENV
# Master-realm admin creds used ONLY by the Keycloak container itself on first boot
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# JWT validation
AUTH_JWKS_URI=http://localhost:8080/realms/documents/protocol/openid-connect/certs
AUTH_ISSUER=http://localhost:8080/realms/documents
AUTH_AUDIENCE=documents-app

# Cognito - used when AUTH_PROVIDER=cognito
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=exampleclientid1234567890

# Frontend
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_WS_URL=ws://localhost

# Gemini API key, used by the Python AI services (all LLM calls go through them)
GEMINI_API_KEY=

# Python AI services. Chat: CHAT_MODEL writes answers; FAST_MODEL routes questions,
# plans calculations and checks answers. Models use LangChain's "<provider>:<model>" form.
CHAT_MODEL=google_genai:gemini-3.1-flash-lite
FAST_MODEL=google_genai:gemini-3.1-flash-lite
# Evaluation judge: Gemma 4 is free (free-tier terms, 30 requests/min); used only on public and synthetic data
JUDGE_MODEL=google_genai:gemma-4-31b-it

# Ingestion worker (Python): figure captions, and one extraction call per document
VISION_MODEL=google_genai:gemini-3.1-flash-lite
EXTRACT_MODEL=google_genai:gemini-3.1-flash-lite
# Parse results and model replies cached by content hash, so reprocessing a file makes
# no calls. Relative to services/ai for commands run there; compose mounts it for the worker.
INGEST_CACHE_DIR=.cache/ingest

# Search index. These are the host defaults for `docai` commands; compose gives the worker
# its own URLs. The live index version sits behind QDRANT_ALIAS (see `docai index list`).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_ALIAS=chunks
TEI_EMBED_URL=http://localhost:8081
TEI_RERANK_URL=http://localhost:8082
# Writes a sentence of context for each chunk before indexing (contextual retrieval); empty uses EXTRACT_MODEL
CONTEXT_MODEL=

# Langfuse tracing is optional: leave these empty to turn it off
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# The chat prompts the AI service serves from Langfuse (docai prompts); without Langfuse,
# or without a version under this label, it uses the repository's prompts
LANGFUSE_PROMPT_LABEL=production
# Keys the hashes that replace tax IDs, account numbers, emails and phone numbers in
# traces. Any long random string, e.g. from `openssl rand -hex 32`; empty, each process
# picks its own, so the same value hashes differently across runs
MASKING_KEY=

# LLM gateway (LiteLLM, the ops profile): spend limits and a fallback model. Empty
# LLM_GATEWAY_URL calls Gemini directly; set it to http://localhost:4000 and start
# `docker compose --profile ops up -d` to route every model call through the gateway.
# The keys are random strings starting with sk-, e.g. "sk-$(openssl rand -hex 24)";
# `docai gateway setup` creates LLM_GATEWAY_KEY, the services' key, in the gateway.
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=
LITELLM_MASTER_KEY=
LLM_GATEWAY_DB_PASSWORD=
# USD per day: across all calls (the kill switch), and per user (chat and uploads)
LLM_GATEWAY_DAILY_BUDGET=5
LLM_GATEWAY_USER_DAILY_BUDGET=0.5

# Grafana (the ops profile), at http://localhost:3030; viewers need no login
GRAFANA_ADMIN_PASSWORD=

# Text Embeddings Inference. On Apple Silicon use TEI_TAG=cpu-arm64-1.9.4.
TEI_TAG=cpu-1.9.4
TEI_EMBED_MODEL=intfloat/multilingual-e5-small
TEI_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
