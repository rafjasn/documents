FROM node:24-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY services/api/package.json services/api/package.json
COPY frontend/package.json frontend/package.json
RUN npm ci

FROM deps AS build
# Next.js writes these into the browser bundle at build time, so the AWS build passes the
# CloudFront address (deploy.yml); unset, next.config.js falls back to localhost.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
COPY frontend frontend
COPY tsconfig.json tsconfig.json
RUN npm run build -w @documents/frontend

FROM deps AS development
COPY frontend/tsconfig.json frontend/tsconfig.json
COPY frontend/next.config.js frontend/next.config.js
COPY frontend/postcss.config.js frontend/postcss.config.js
COPY frontend/tailwind.config.ts frontend/tailwind.config.ts
WORKDIR /app
EXPOSE 3000
CMD ["npm", "run", "dev", "-w", "@documents/frontend"]

FROM base AS production
COPY --from=build /app/frontend/.next/standalone ./
COPY --from=build /app/frontend/.next/static ./frontend/.next/static

WORKDIR /app/frontend
# The standalone server listens on HOSTNAME, which a container otherwise sets to its own name.
ENV HOSTNAME=0.0.0.0 PORT=3000
EXPOSE 3000

CMD ["node", "server.js"]
